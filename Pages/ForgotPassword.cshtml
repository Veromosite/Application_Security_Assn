@page
@model WebApplication1.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password - Ace Job Agency";
}

<div class="container mt-5">
    <div class="row justify-content-center">
 <div class="col-md-6 col-lg-5">
        <div class="card shadow">
   <div class="card-body">
  <h1 class="card-title text-center mb-4">
   <i class="bi bi-lock-fill"></i> Forgot Password
         </h1>

         @if (Model.EmailSent)
        {
           <div class="alert alert-success">
            <i class="bi bi-envelope-check"></i>
      <strong>Verification Code Sent!</strong>
     <p class="mb-0">We've sent a 6-digit verification code to your email address. Please check your inbox and enter the code to reset your password.</p>
     </div>
       <div class="text-center mt-3">
<p class="text-muted">Didn't receive the code? Check your spam folder.</p>
      </div>
          }
            else
{
         <div class="alert alert-info mb-4">
   <i class="bi bi-info-circle"></i>
     Enter your email address and we'll send you a verification code to reset your password.
     </div>

       <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="mb-3">
     <label class="form-label" asp-for="FPModel.Email">
      <i class="bi bi-envelope"></i> Email Address
       </label>
  <input type="email" asp-for="FPModel.Email" class="form-control" placeholder="Enter your email" />
 <span asp-validation-for="FPModel.Email" class="text-danger"></span>
         </div>

             <div class="d-grid mb-3">
    <button type="submit" class="btn btn-primary btn-lg">
      <i class="bi bi-send"></i> Send Verification Code
      </button>
        </div>

              <hr>

   <div class="text-center">
       <a asp-page="Login" class="text-decoration-none">
         <i class="bi bi-arrow-left"></i> Back to Login
       </a>
        </div>
          </form>
        }
   </div>
      </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
