@page
@using System.Text.Encodings.Web
@model IndexModel
@{
    ViewData["Title"] = "Home - Ace Job Agency";
}

@if (Model.CurrentUser != null)
{
    <!-- Logged In User Dashboard -->
    <div class="welcome-hero mb-5">
        <div class="container">
            <div class="row align-items-center py-5">
     <div class="col-lg-8 col-md-7">
 <div class="welcome-content">
     <h1 class="display-4 fw-bold mb-3 animate-fade-in">
     <i class="bi bi-person-circle me-2"></i> 
   Welcome back, <span class="text-gradient">@Model.CurrentUser.FirstName</span>!
      </h1>
 <p class="lead mb-4 animate-fade-in-delay">
  <i class="bi bi-briefcase me-2"></i>
          Manage your profile and explore new opportunities
 </p>
 <div class="d-flex gap-3 animate-fade-in-delay-2">
              <a asp-page="/ChangePassword" class="btn btn-light btn-lg shadow-sm">
     <i class="bi bi-key"></i> Change Password
      </a>
      <a href="#profile" class="btn btn-outline-light btn-lg">
<i class="bi bi-arrow-down"></i> View Profile
   </a>
       </div>
             </div>
           </div>
                <div class="col-lg-4 col-md-5 text-center d-none d-md-block">
            <div class="welcome-illustration">
  <i class="bi bi-person-badge-fill"></i>
         </div>
         </div>
       </div>
        </div>
    </div>

<div class="container my-5" id="profile">
     <div class="row g-4">
  <!-- Profile Card -->
     <div class="col-lg-8">
      <div class="card shadow-lg border-0 h-100">
  <div class="card-header bg-white border-bottom">
    <h3 class="mb-0">
<i class="bi bi-person-badge text-primary"></i> Your Profile
     </h3>
          </div>
    <div class="card-body p-4">
      <div class="row g-4">
          <!-- Personal Information -->
              <div class="col-md-6">
            <div class="info-item">
          <label class="text-muted small mb-1">
          <i class="bi bi-person"></i> First Name
  </label>
           <p class="fw-semibold mb-0">@HtmlEncoder.Default.Encode(Model.CurrentUser.FirstName)</p>
         </div>
  </div>
      <div class="col-md-6">
        <div class="info-item">
       <label class="text-muted small mb-1">
  <i class="bi bi-person"></i> Last Name
           </label>
      <p class="fw-semibold mb-0">@HtmlEncoder.Default.Encode(Model.CurrentUser.LastName)</p>
           </div>
            </div>
    <div class="col-md-6">
    <div class="info-item">
                  <label class="text-muted small mb-1">
            <i class="bi bi-gender-ambiguous"></i> Gender
</label>
         <p class="fw-semibold mb-0">@HtmlEncoder.Default.Encode(Model.CurrentUser.Gender)</p>
   </div>
          </div>
      <div class="col-md-6">
      <div class="info-item">
     <label class="text-muted small mb-1">
               <i class="bi bi-calendar"></i> Date of Birth
                </label>
  <p class="fw-semibold mb-0">@Model.CurrentUser.DateOfBirth.ToString("MMM dd, yyyy")</p>
      </div>
     </div>
        <div class="col-md-6">
                  <div class="info-item">
        <label class="text-muted small mb-1">
<i class="bi bi-envelope"></i> Email Address
    </label>
     <p class="fw-semibold mb-0 text-break">@Model.CurrentUser.Email</p>
         </div>
               </div>
     <div class="col-md-6">
              <div class="info-item">
  <label class="text-muted small mb-1">
        <i class="bi bi-shield-lock"></i> NRIC
           </label>
       <p class="fw-semibold mb-0 text-primary">@Model.DecryptedNRIC</p>
          <small class="text-muted"><i class="bi bi-lock"></i> Encrypted in database</small>
</div>
       </div>
 
  @if (!string.IsNullOrEmpty(Model.CurrentUser.ResumePath))
{
    <div class="col-12">
     <div class="info-item">
           <label class="text-muted small mb-2">
         <i class="bi bi-file-earmark-pdf"></i> Resume
     </label>
       <div>
    <a href="@Model.CurrentUser.ResumePath" target="_blank" class="btn btn-outline-primary">
     <i class="bi bi-download"></i> View Resume
  </a>
        </div>
  </div>
              </div>
        }

        @if (!string.IsNullOrEmpty(Model.CurrentUser.WhoAmI))
         {
     <div class="col-12">
    <div class="info-item">
  <label class="text-muted small mb-2">
          <i class="bi bi-chat-left-quote"></i> About Me
              </label>
                   <div class="p-3 bg-light rounded">
      <p class="mb-0">@Html.Raw(HtmlEncoder.Default.Encode(Model.CurrentUser.WhoAmI).Replace("\n", "<br/>"))</p>
         </div>
             </div>
      </div>
       }
      </div>
</div>
                </div>
    </div>

          <!-- Quick Actions Sidebar -->
  <div class="col-lg-4">
        <div class="card shadow-lg border-0 mb-4">
            <div class="card-header bg-primary text-white">
     <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
   </div>
         <div class="list-group list-group-flush">
  <a asp-page="/ChangePassword" class="list-group-item list-group-item-action">
    <i class="bi bi-key text-warning"></i> Change Password
         </a>
      <a href="#" class="list-group-item list-group-item-action">
     <i class="bi bi-briefcase text-success"></i> Browse Jobs
        </a>
                  <a href="#" class="list-group-item list-group-item-action">
        <i class="bi bi-file-earmark-text text-info"></i> Update Resume
           </a>
  <a asp-page="/Logout" class="list-group-item list-group-item-action text-danger">
     <i class="bi bi-box-arrow-right"></i> Logout
   </a>
        </div>
</div>

        <!-- Account Status -->
             <div class="card shadow-lg border-0">
  <div class="card-header bg-success text-white">
     <h5 class="mb-0"><i class="bi bi-check-circle"></i> Account Status</h5>
            </div>
            <div class="card-body">
      <div class="d-flex align-items-center mb-3">
       <i class="bi bi-shield-check text-success fs-4 me-2"></i>
           <div>
   <small class="text-muted">Email Verified</small>
   <p class="mb-0 fw-bold text-success">✓ Confirmed</p>
                 </div>
          </div>
          <div class="d-flex align-items-center mb-3">
               <i class="bi bi-lock text-primary fs-4 me-2"></i>
    <div>
         <small class="text-muted">2FA Enabled</small>
      <p class="mb-0 fw-bold text-primary">✓ Active</p>
        </div>
               </div>
        <div class="d-flex align-items-center">
         <i class="bi bi-shield-lock-fill text-info fs-4 me-2"></i>
            <div>
           <small class="text-muted">Data Encryption</small>
   <p class="mb-0 fw-bold text-info">✓ AES-256</p>
          </div>
       </div>
           </div>
    </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Landing Page for Non-Logged In Users -->
    <!-- Hero Section -->
    <div class="hero-section" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 100px 0;">
        <div class="container">
            <div class="row align-items-center">
  <div class="col-lg-6 mb-5 mb-lg-0">
    <h1 class="display-3 fw-bold mb-4">Find Your Dream Job</h1>
     <p class="lead mb-4">Join thousands of professionals who trust Ace Job Agency to advance their careers</p>
      <div class="d-flex gap-3">
        <a asp-page="Register" class="btn btn-light btn-lg px-5">
          <i class="bi bi-person-plus"></i> Get Started
          </a>
   <a asp-page="Login" class="btn btn-outline-light btn-lg px-5">
          <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
    </div>
          </div>
    <div class="col-lg-6 text-center">
      <i class="bi bi-briefcase-fill" style="font-size: 15rem; opacity: 0.3;"></i>
 </div>
     </div>
        </div>
    </div>

    <!-- Features Section -->
  <div class="container my-5 py-5">
 <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Why Choose Us?</h2>
       <p class="lead text-muted">Your success is our priority</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
            <div class="card h-100 border-0 shadow-lg hover-lift">
         <div class="card-body text-center p-5">
         <div class="mb-4">
     <i class="bi bi-shield-check text-primary" style="font-size: 4rem;"></i>
     </div>
    <h4 class="fw-bold mb-3">Secure & Private</h4>
           <p class="text-muted">Your data is protected with AES-256 encryption and 2FA authentication</p>
   </div>
     </div>
            </div>
        <div class="col-md-4">
  <div class="card h-100 border-0 shadow-lg hover-lift">
 <div class="card-body text-center p-5">
       <div class="mb-4">
  <i class="bi bi-people text-success" style="font-size: 4rem;"></i>
              </div>
      <h4 class="fw-bold mb-3">Expert Support</h4>
          <p class="text-muted">Our team of professionals is here to guide you every step of the way</p>
  </div>
    </div>
  </div>
        <div class="col-md-4">
     <div class="card h-100 border-0 shadow-lg hover-lift">
  <div class="card-body text-center p-5">
     <div class="mb-4">
      <i class="bi bi-graph-up-arrow text-warning" style="font-size: 4rem;"></i>
     </div>
    <h4 class="fw-bold mb-3">Career Growth</h4>
       <p class="text-muted">Access exclusive opportunities from top companies worldwide</p>
          </div>
  </div>
          </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="bg-light py-5">
        <div class="container">
            <div class="row text-center g-4">
          <div class="col-md-3">
                    <div class="stat-item">
   <h2 class="display-4 fw-bold text-primary mb-2">10K+</h2>
         <p class="text-muted">Active Users</p>
        </div>
  </div>
 <div class="col-md-3">
          <div class="stat-item">
      <h2 class="display-4 fw-bold text-success mb-2">5K+</h2>
 <p class="text-muted">Jobs Posted</p>
      </div>
          </div>
             <div class="col-md-3">
 <div class="stat-item">
        <h2 class="display-4 fw-bold text-warning mb-2">500+</h2>
       <p class="text-muted">Companies</p>
</div>
      </div>
     <div class="col-md-3">
    <div class="stat-item">
        <h2 class="display-4 fw-bold text-info mb-2">98%</h2>
      <p class="text-muted">Success Rate</p>
        </div>
       </div>
            </div>
        </div>
    </div>
}

@section Styles {
  <!-- Styles moved to wwwroot/css/site.css for better performance -->
}
