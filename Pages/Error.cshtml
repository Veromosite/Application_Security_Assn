@page "{code?}"
@model ErrorModel
@{
    ViewData["Title"] = $"Error {Model.StatusCode}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            @if (Model.StatusCode == 404)
            {
                <h1 class="display-1 text-danger">404</h1>
                <h2 class="mb-4">Page Not Found</h2>
                <p class="lead">Sorry, the page you're looking for doesn't exist.</p>
                <div class="mt-4">
                    <a asp-page="/Index" class="btn btn-primary">Go to Home</a>
                </div>
            }
            else if (Model.StatusCode == 403)
            {
                <h1 class="display-1 text-danger">403</h1>
                <h2 class="mb-4">Access Denied</h2>
                <p class="lead">You don't have permission to access this resource.</p>
                <div class="mt-4">
                    <a asp-page="/Index" class="btn btn-primary">Go to Home</a>
                </div>
            }
            else
            {
                <h1 class="display-1 text-danger">Error</h1>
                <h2 class="mb-4">Something went wrong</h2>
                <p class="lead">We're sorry, but an error occurred while processing your request.</p>
                <div class="mt-4">
                    <a asp-page="/Index" class="btn btn-primary">Go to Home</a>
                </div>
            }
        </div>
    </div>
</div>
